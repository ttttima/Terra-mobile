<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Terra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/panel</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- Web pages see Terra's color mode (prefers-color-scheme) through
         their theme; see Tabs.kt. -->
    <style name="Theme.Terra.PageDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:isLightTheme">false</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Theme.Terra.PageLight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
